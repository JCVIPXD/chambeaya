{
  "name": "cumple-now",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace=@cumple-now/api",
    "dev:mobile": "powershell -ExecutionPolicy Bypass -File scripts/run-mobile.ps1",
    "dev:web": "npm run dev --workspace=@cumple-now/web",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  }
}
