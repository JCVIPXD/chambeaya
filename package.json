{
  "name": "chambeaya",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web", "packages/*"],
  "scripts": {
    "dev:api": "npm run dev --workspace=@chambeaya/api",
    "dev:mobile": "powershell -ExecutionPolicy Bypass -File scripts/run-mobile.ps1",
    "dev:web": "npm run dev --workspace=@chambeaya/web",
    "demo:seed": "powershell -ExecutionPolicy Bypass -File scripts/seed-demo.ps1",
    "demo:smoke": "powershell -ExecutionPolicy Bypass -File scripts/demo-smoke.ps1",
    "test": "npm run test --workspaces --if-present",
    "test:web": "npm run test --workspace=@chambeaya/web --",
    "test:web:ui": "npm run test:ui --workspace=@chambeaya/web --",
    "test:web:report": "npm run test:report --workspace=@chambeaya/web",
    "test:web:install": "npm exec --workspace=@chambeaya/web -- playwright install chromium",
    "test:web:admin-real": "npm run test:web:admin-real --workspace=@chambeaya/web --",
    "build": "npm run build --workspaces --if-present"
  }
}
