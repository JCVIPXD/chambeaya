# Copia este archivo como .env.production y cambia todos los valores sensibles.
POSTGRES_USER=chambeaya
POSTGRES_PASSWORD=cambia-esta-clave-por-una-larga-y-aleatoria
POSTGRES_DB=chambeaya
DATABASE_URL=postgresql://chambeaya:cambia-esta-clave-por-una-larga-y-aleatoria@db:5432/chambeaya?schema=public
API_PORT=4000
# Puertos publicados en 127.0.0.1 (ver docker-compose.production.yml); el
# Nginx del host hace proxy_pass hacia ellos. scripts/instalar-produccion.sh
# los elige automáticamente la primera vez comprobando cuáles están libres
# (empieza en 4100/3100/8100) y nunca los cambia en ejecuciones posteriores.
API_HOST_PORT=4000
WEB_HOST_PORT=3000
APP_HOST_PORT=3100
# Un solo dominio con tres rutas (CN-20260925-006): "/" es la app del
# trabajador, "/empresas" el panel y "/api" la API. Las tres URLs de abajo
# comparten el mismo dominio; scripts/instalar-produccion.sh las genera así
# a partir del único --domain que pide.

# URL pública que usará el navegador para llamar a la API.
NEXT_PUBLIC_API_URL=https://tudominio.com/api
# URL de la API que se compila DENTRO del binario de la app del trabajador
# (Flutter web, apps/mobile_flutter/Dockerfile.production). Debe ser la misma
# URL pública que NEXT_PUBLIC_API_URL, con el mismo sufijo /api. Cambiarla
# exige reconstruir la imagen worker-app (./scripts/deploy-hosting.sh ya lo
# hace); no es una variable que la app lea en tiempo de ejecución.
API_BASE_URL=https://tudominio.com/api
# Prefijo con el que se compila el panel Next.js (apps/web/next.config.ts,
# build-arg de apps/web/Dockerfile.production): fijo en compilación, igual
# que API_BASE_URL, y también debe llegar al contenedor en tiempo de
# ejecución porque `next start` vuelve a leer next.config.ts al arrancar. En
# desarrollo (npm run dev, docker-compose.yml, Playwright) esta variable no
# existe y el panel queda en la raíz, sin cambios.
NEXT_BASE_PATH=/empresas
# Obligatoria para scripts/deploy-hosting.sh: orígenes permitidos por CORS,
# separados por comas si hay más de uno. Con un solo dominio para panel, app
# y API, es el mismo dominio de arriba; el panel y la app llaman a la API
# desde su propio origen, así que CORS solo decide qué OTROS orígenes de
# navegador pueden usarla. Si llegara vacía, la API no autoriza ningún origen
# externo (no abre el acceso en silencio).
CORS_ALLOWED_ORIGINS=https://tudominio.com
# Límite de intentos de las rutas de autenticación (login, registro, Google,
# password). Por defecto: 20 solicitudes cada 15 minutos por IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Si hay un proxy inverso (Nginx/Caddy) delante de la API, configúralo para
# que el límite de intentos cuente por la IP real del cliente y no por la del
# proxy. Usa el número exacto de saltos de proxy que tenga tu topología (con
# el Nginx del host de scripts/instalar-produccion.sh, que es un solo salto,
# eso es "1"). NO uses "true": Express confiaría entonces en todo el
# contenido de X-Forwarded-For, que controla el cliente, y cualquiera podría
# falsificar su IP con esa cabecera para saltarse el límite de intentos de
# /api/auth (demostrado en la auditoría de CN-20260925-001, ver
# docs/PROGRESO.md CN-20260925-002).
API_TRUST_PROXY=1
# Configurar únicamente al activar OAuth y almacenamiento privado de documentos.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
DOCUMENT_STORAGE_DRIVER=
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ROOT=
