# Copia este archivo como .env.production y cambia todos los valores sensibles.
POSTGRES_USER=chambeaya
POSTGRES_PASSWORD=cambia-esta-clave-por-una-larga-y-aleatoria
POSTGRES_DB=chambeaya
DATABASE_URL=postgresql://chambeaya:cambia-esta-clave-por-una-larga-y-aleatoria@db:5432/chambeaya?schema=public
API_PORT=4000
API_HOST_PORT=4000
WEB_HOST_PORT=3000
# URL pública que usará el navegador para llamar a la API.
NEXT_PUBLIC_API_URL=https://api.tudominio.com/api
# Obligatoria en producción: orígenes permitidos por CORS, separados por
# comas (ej. https://tudominio.com). Si se deja vacía, la API bloquea todos
# los orígenes de navegador en lugar de abrir el acceso en silencio.
CORS_ALLOWED_ORIGINS=https://tudominio.com
# Límite de intentos de las rutas de autenticación (login, registro, Google,
# password). Por defecto: 20 solicitudes cada 15 minutos por IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# Si hay un proxy inverso (Nginx/Caddy) delante de la API, configúralo para
# que el límite de intentos cuente por la IP real del cliente y no por la del
# proxy. "true" habilita X-Forwarded-For sin restricción (solo si controlas
# el proxy); usa un número de saltos si conoces la topología exacta.
API_TRUST_PROXY=true
# Configurar únicamente al activar OAuth y almacenamiento privado de documentos.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
DOCUMENT_STORAGE_DRIVER=
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ROOT=
