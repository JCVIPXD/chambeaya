POSTGRES_USER=chambeaya
POSTGRES_PASSWORD=chambeaya_dev
POSTGRES_DB=chambeaya
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql://chambeaya:chambeaya_dev@db:5432/chambeaya?schema=public
API_PORT=4000
API_HOST_PORT=4000
WEB_HOST_PORT=3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000/api
# Orígenes permitidos por CORS, separados por comas. Vacío en desarrollo
# conserva el comportamiento permisivo actual (necesario para Flutter y para
# abrir el panel web desde distintos puertos locales).
CORS_ALLOWED_ORIGINS=
# Límite de intentos de las rutas de autenticación (login, registro, Google,
# password). Por defecto: 20 solicitudes cada 15 minutos por IP.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
# "true" | "false" | número de saltos de proxy | valor de Express para
# `trust proxy` (ver https://expressjs.com/en/guide/behind-proxies.html).
# Vacío en desarrollo local sin proxy inverso.
API_TRUST_PROXY=
# Preparados para una integración posterior; no activan proveedores por sí solos.
GOOGLE_OAUTH_WEB_CLIENT_ID=
GOOGLE_OAUTH_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ANDROID_CLIENT_ID=
GOOGLE_OAUTH_IOS_CLIENT_ID=
DOCUMENT_STORAGE_DRIVER=
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_ROOT=private-documents
