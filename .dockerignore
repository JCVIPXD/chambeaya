apps/mobile_flutter/ios/Pods
apps/mobile_flutter/ios/.symlinks
apps/mobile_flutter/*.iml
# Rutas locales del SDK de Android de quien compila; no hace falta para
# `flutter build web` y no debería entrar al contexto de build (BAJO-4 de
# CN-20260925-002).
